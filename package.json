{
  "name": "gridforce",
  "version": "0.0.0",
  "private": true,
  "description": "GridForce — co-op grid-defense game. Phase 0: engine + netcode foundation.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint \"packages/**/*.ts\"",
    "lint:fix": "eslint --fix \"packages/**/*.ts\"",
    "format": "prettier --write \"packages/**/*.{ts,js,tsx,json,md}\" \"*.{ts,js,json,md}\" \"docs/*.md\"",
    "format:check": "prettier --check \"packages/**/*.{ts,js,tsx,json,md}\" \"*.{ts,js,json,md}\" \"docs/*.md\"",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @gridforce/server\" \"npm run dev -w @gridforce/client\"",
    "dev:server": "npm run dev -w @gridforce/server",
    "dev:client": "npm run dev -w @gridforce/client"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.2"
  },
  "engines": {
    "node": ">=18"
  }
}
