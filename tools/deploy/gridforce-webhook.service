[Unit]
Description=GridForce GitHub webhook receiver
After=network.target

[Service]
Type=simple
User=gridforce
Group=gridforce
WorkingDirectory=/opt/gridforce
EnvironmentFile=/etc/gridforce/webhook.env
Environment=GIT_SSH_COMMAND=ssh -i /etc/gridforce/deploy_key -o UserKnownHostsFile=/etc/gridforce/known_hosts -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes
ExecStart=/usr/bin/node tools/deploy/webhook-server.mjs
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

# NOTE: NoNewPrivileges is deliberately NOT set. The deploy script needs to
# escalate via sudo to run `systemctl restart gridforce` (allowed via
# /etc/sudoers.d/gridforce). NoNewPrivileges blocks setuid binaries like
# sudo from elevating, even when sudoers permits the command — leaving it
# on causes deploy.sh to fail at the restart step with "no new privileges".
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
